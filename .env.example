# ---------------------------------------------------------------------------
# OPENPANOPTICON — copy this file to ".env" and fill in what you have.
# Nothing here is ever sent to the browser; the server holds every credential.
# ---------------------------------------------------------------------------

# REQUIRED for the Shodan layer. https://account.shodan.io/
SHODAN_API_KEY=

# OPTIONAL — worldwide public webcams. Free tier at https://api.windy.com/keys
# Without it you still get NYC DOT traffic cameras.
WINDY_API_KEY=

# OPTIONAL — OpenWebcamDB, a hand-curated directory of ~1,500 public streams.
# Free for non-commercial use: https://openwebcamdb.com/api
OPENWEBCAMDB_API_KEY=

# OPTIONAL — geotagged YouTube uploads near the view (the search that
# mattw.io/youtube-geofind runs). A YouTube Data API v3 key from Google Cloud:
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
# Free quota is 10,000 units/day; one new view costs up to ~300. How far back
# it looks (72h) and how long a search is kept (72h) are in cache.conf [youtube].
YOUTUBE_API_KEY=

# OPTIONAL — NASA FIRMS active-fire detections (VIIRS, near-real-time).
# Free map key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# OPTIONAL — RSOE EDIS (rsoe-edis.org). Their event feed is an enterprise
# product with no free tier (GeoJSON API, €4,000/year at time of writing).
# If you license it, put the GeoJSON events URL and token here and the EDIS
# source appears in the situational-awareness layer.
# The free, no-key sources already wired in — GDACS, NASA EONET, USGS and
# NWS — cover much of the same ground.
EDIS_API_URL=
EDIS_API_KEY=

# OPTIONAL — your own Overpass instance(s), comma-separated, tried in order.
# The public servers (overpass-api.de, overpass.private.coffee) are donated
# capacity and rate-limit hard; busy cities with many feature classes on can
# wait minutes for a slot. A self-hosted or paid instance has no such limit.
# Leave empty to use the public ones.
OVERPASS_URL=

# OPTIONAL — place and road name labels (the LABELS button). Since
# 25 Sep 2026 CARTO serves its tiles only with a key. Free, no account needed:
# https://carto.com/basemaps/apikey  (choose non-commercial). Leave website
# restrictions off, or allow 127.0.0.1 / localhost — the server proxies the
# tiles and forwards your browser's Referer.
CARTO_API_KEY=

# OPTIONAL — unlocks world terrain + global 3D buildings.
# Free account at https://ion.cesium.com/tokens
# Without it the globe uses OpenStreetMap raster imagery on a smooth ellipsoid.
CESIUM_ION_TOKEN=

# OPTIONAL — raises OpenSky from 400 to 4,000 credits/day and 10s to 5s
# resolution. Create an API client at https://opensky-network.org/my-opensky
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# OPTIONAL — Space-Track.org login, the official US Space Force catalogue that
# CelesTrak redistributes. Free: https://www.space-track.org/auth/createAccount
# Used only when CelesTrak cannot answer (down, or it has blocked this address).
# The whole catalogue is downloaded at most hourly and groups are picked out
# locally; curated groups (brightest, military, science...) are approximate.
SPACETRACK_USER=
SPACETRACK_PASSWORD=

# Credits held back from automatic polling, so a deliberate look still works
# after a day of the map being left open. OpenSky refills at 00:00 UTC.
# OPENSKY_CREDIT_FLOOR=60

# ---------------------------------------------------------------------------
# Vessels, devices and activity
# ---------------------------------------------------------------------------

# OPTIONAL — live AIS ship positions. Free key: https://aisstream.io/
# The server holds one websocket and serves the vessel table over REST.
AISSTREAM_API_KEY=

# OPTIONAL — cell towers. Free key (contribute data to keep it free):
# https://opencellid.org/register.php
OPENCELLID_API_KEY=

# OPTIONAL — WiFi / Bluetooth wardriving survey. Free account, heavily
# throttled: https://wigle.net/account  (use the API Name + API Token, not
# your login password)
WIGLE_API_NAME=
WIGLE_API_TOKEN=

# OPTIONAL — GreyNoise scanner reputation. Works unauthenticated at 10
# lookups/day; a free key raises that. https://viz.greynoise.io/signup
GREYNOISE_API_KEY=

# OPTIONAL — US electricity demand by balancing authority, hourly.
# Free key: https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# OPTIONAL — Cloudflare Radar internet outage annotations.
# Free token with Radar:Read: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=

# OPTIONAL — state 511 traffic cameras, incidents and closures.
# Format: "GA:yourkey,NY:yourkey,TX:yourkey". Each state issues its own free
# key from its 511 developer page. Known states: GA LA AZ NY FL IA NE KY MA
# NH VT ME WI IN MD UT CO NV WY MT SD ND KS
FIVE_ELEVEN_KEYS=

# Server binding. Leave HOST as 127.0.0.1 unless you deliberately want this
# reachable from other machines on your network.
PORT=8420
HOST=127.0.0.1

# ---------------------------------------------------------------------------
# BASE MAP
# ---------------------------------------------------------------------------
# Sentinel-2 imagery needs no credentials at all: scenes are found through the
# Earth Search STAC API and rendered by a TiTiler instance, both public.
# titiler.xyz is a free demo with no SLA — point this at your own deployment
# if you use it seriously.
# TITILER_URL=https://titiler.xyz

# Shortbread vector tiles (OpenStreetMap, drawn client-side in the terminal
# palette). Defaults to VersaTiles, which is public, unauthenticated and
# CORS-open to zoom 14. Point this at a local versatiles instance to run the
# base map offline.
# SHORTBREAD_URL=https://tiles.versatiles.org/tiles/osm/{z}/{x}/{y}

# Google Earth Engine is optional and only appears in the menu once all three
# are set. Create a Google Cloud project, enable the Earth Engine API, register
# the project at https://code.earthengine.google.com, then make a service
# account with the "Earth Engine Resource Viewer" role and download its JSON
# key. GEE_PRIVATE_KEY is the "private_key" field — keep the \n escapes.
# GEE_PROJECT=my-gcp-project-id
# GEE_CLIENT_EMAIL=earthengine@my-gcp-project-id.iam.gserviceaccount.com
# GEE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n

# ---------------------------------------------------------------------------
# SHODAN BUDGET
# ---------------------------------------------------------------------------
# One query covers a fixed grid cell rather than the current view, so panning
# and zooming around a place reuse a single credit. Bigger cells mean fewer
# credits and coarser results. 0.25 degrees is roughly 28km.
# SHODAN_CELL_DEG=0.25

# Stop spending when the account falls to this many query credits, leaving a
# reserve for deliberate lookups. Set to 0 to spend down to nothing.
# SHODAN_CREDIT_FLOOR=10

# How long maps, Shodan results, Overpass data and everything else are kept
# is set in cache.conf, next to this file (written on first start).
